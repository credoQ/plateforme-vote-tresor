# Modèle du .env du serveur (déploiement Docker) : copier en .env sur le serveur et remplir.
# Ne jamais versionner le .env rempli.

APP_NAME="Femme modèle du Trésor"
APP_ENV=production
# Générée une seule fois sur le serveur, voir docs/DEPLOIEMENT_DOCKER.md. Ne JAMAIS la changer ensuite :
# elle signe la chaîne des empreintes des bulletins, les codes de connexion et les liens de vérification.
# Une autre clé rendrait les urnes invérifiables. La garder aussi hors du serveur, avec les sauvegardes.
APP_KEY=
APP_DEBUG=false
# L'adresse publique du site : https://SITE_DOMAIN, ou http://IP_DU_SERVEUR sans domaine
APP_URL=https://vote.exemple.bj
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Essais uniquement : true accepte n'importe quel code de connexion. Toujours false pour une édition réelle.
CONNEXION_CODE_LIBRE=false

# Premier administrateur, créé par « php artisan db:seed --force » s'il n'existe pas encore.
PREMIER_ADMIN_LOGIN=
PREMIER_ADMIN_NOM=
PREMIER_ADMIN_EMAIL=

# Les journaux sortent sur la console des conteneurs : docker compose logs app
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# DB_HOST et DB_PORT sont imposés par compose.yaml (le conteneur db).
DB_CONNECTION=pgsql
DB_DATABASE=femme_modele
DB_USERNAME=femme_modele
# Mot de passe long et aléatoire : openssl rand -base64 32
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# false seulement sans domaine, quand le site est en HTTP
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
# Plus long que le timeout du worker (120 s), sinon une tâche longue serait relancée en parallèle.
DB_QUEUE_RETRY_AFTER=180
# Seul le cache fichier est disponible sur le serveur (dans le volume stockage, partagé par les conteneurs).
CACHE_STORE=file

FILESYSTEM_DISK=local

# Codes de connexion, annonces et accusés de vote : uniquement par e-mail.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="vote@exemple.bj"
MAIL_FROM_NAME="${APP_NAME}"
# Secondes de pause entre deux envois du worker : 1 pour un SMTP limité par seconde (offre gratuite), 0 sinon.
WORKER_PAUSE=0

# Serveur de 12 Go et 6 CPU partagé avec une autre application (environ 6 Go : PHP 3 Go, PostgreSQL 3 Go).
# Part de la plateforme de vote : environ 2 Go au plus, largement assez pour 1 000 électeurs.

# Requêtes PHP traitées en même temps (environ 50 Mo chacune) : 20 processus, environ 1 Go.
PHP_FPM_MAX_CHILDREN=20

# PostgreSQL : la base de vote est petite (quelques dizaines de Mo), 512 Mo de cache la contiennent entière.
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=2GB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=256MB

# Sauvegarde de la base dans ./sauvegardes : toutes les 6 heures, gardée 30 jours.
# Pendant un scrutin ouvert, 3600 (chaque heure) limite la perte possible.
SAUVEGARDE_INTERVALLE=21600
SAUVEGARDE_JOURS=30

# Port de la base sur 127.0.0.1 du serveur (tunnel SSH) : 5433 est déjà pris sur le serveur.
DB_FORWARD_PORT=5434

# Serveur partagé : le domaine du site de vote se déclare dans le Caddy principal du serveur (voir docs/DEPLOIEMENT_DOCKER.md).
# Les lignes suivantes ne servent que sur un serveur dédié, en décommentant COMPOSE_PROFILES.
# COMPOSE_PROFILES=entree
SITE_DOMAIN=vote.exemple.bj
HTTP_PORT=80
HTTPS_PORT=443
